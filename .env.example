NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./data/wistalk.sqlite

# Generate a long random value before production use:
# openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-secret

# Comma-separated origins that may call the API. Keep empty in same-origin deployment.
CORS_ORIGINS=http://localhost:8787,https://simonlvpin.github.io

# Bootstrap admin account. The password is only used when the user does not exist yet.
ADMIN_EMAIL=Simon.Lv@fanruan.com
ADMIN_INITIAL_PASSWORD=ChangeMe-2026!

# Upload safety limits.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_FILE_SIZE_MB=50

# Optional KMS integration. Keep the token private and never commit real values.
KMS_HOST=kms.fineres.com
KMS_API_TOKEN=
